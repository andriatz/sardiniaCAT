# Mistral (vive solo sul server, mai nel client)
MISTRAL_API_KEY=sk-...
MISTRAL_MODEL=mistral-small-latest

# Server web
PORT=3000
HOST=127.0.0.1

# Watcher Opportunita Kode
ENABLE_SCRAPER=true
# Pagina (pubblica) da monitorare, es. la sezione careers/opportunita di Kode.
# Se e' un endpoint JSON (es. board Greenhouse/Lever), viene interpretato come JSON.
OPPORTUNITIES_URL=https://www.esempio-kode.it/careers
# Filtro opzionale: tieni solo i link che contengono questa stringa nell'URL (es. /job)
OPPORTUNITIES_FILTER=/job
POLL_MINUTES=60
# true (default): primo controllo immediato all'avvio del server, poi ogni POLL_MINUTES
RUN_ON_START=true
STATE_FILE=data/seen.json

# Email via SMTP. Se SMTP_HOST e' vuoto, le email vengono solo stampate a log (dry-run).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
