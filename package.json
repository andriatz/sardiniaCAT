{
  "name": "kode-opportunita-watch",
  "version": "1.0.0",
  "private": true,
  "description": "Chat con Mistral (SDK TypeScript ufficiale) + watcher Opportunita Kode con notifica email",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "scrape:once": "tsx src/scrape-once.ts"
  },
  "dependencies": {
    "@mistralai/mistralai": "^3.5.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
